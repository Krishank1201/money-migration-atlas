{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://money-migration-atlas.onrender.com/api/:path*"
        },
        {
            "source": "/health",
            "destination": "https://money-migration-atlas.onrender.com/health"
        }
    ]
}