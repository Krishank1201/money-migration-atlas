# Money Migration Atlas - Environment Configuration

# Core Application Settings
DEMO_MODE=true
RANDOM_SEED=42
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Graph Database (Optional in DEMO_MODE; system falls back to in-memory NetworkX if unreachable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

